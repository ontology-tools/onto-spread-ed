{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Flask behind the Vite dev server: plain HTTP on :5000, Vite terminates TLS on :8080
            "name": "Python Debugger: Flask behind Vite",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "FLASK_APP": "ose_app:create_app",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development",
                "FLASK_SECRET_KEY": "fsasfdjoi",
                "OSE_LOG_LEVEL": "debug",
                "OSE_ENVIRONMENT": "development",
                "ROBOT": "${env:HOME}/.local/bin/robot",
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "run",
                "--debug",
                "--port",
                "5000",
            ],
            "justMyCode": false,
            "autoStartBrowser": false,
            "presentation": {
                "hidden": true
            }
        },
        {
            // Executes the releases started in the web app
            "name": "Python Debugger: Release runner",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "FLASK_APP": "ose_app:create_app",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development",
                "FLASK_SECRET_KEY": "fsasfdjoi",
                "OSE_LOG_LEVEL": "debug",
                "OSE_ENVIRONMENT": "development",
                "ROBOT": "${env:HOME}/.local/bin/robot",
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "release-runner",
            ],
            "justMyCode": false,
            "presentation": {
                "hidden": true
            }
        },
        {
            // Builds js-core and the shims, then serves the SPA with HMR on https://localhost:8080.
            "name": "Vite dev server on :8080",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}",
            "env": {
                "FLASK_PORT": "5000",
                "OSE_DEV_PORT": "8080",
                "OSE_DEV_SSL_CERT": "${workspaceFolder}/ssl/cert.pem",
                "OSE_DEV_SSL_KEY": "${workspaceFolder}/ssl/key.pem"
            },
            "presentation": {
                "hidden": true
            }
        },
    ],
    "compounds": [
        {
            // Starts Flask, the release runner and Vite
            "name": "OSE: Dev (Flask debugger + Vite)",
            "configurations": [
                "Python Debugger: Flask behind Vite",
                "Python Debugger: Release runner",
                "Vite dev server on :8080"
            ],
            "preLaunchTask": "OSE: Update DB",
            "stopAll": true,
            "presentation": {
                "order": 1
            }
        }
    ]
}